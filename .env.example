# Variables de entorno para La Tribuna.
# Copiar este archivo a `.env` y completar con valores reales.
# NUNCA commitear el .env real — está excluido por .gitignore.

# Base de datos SQLite local (se crea sola con `bun run db:push`)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Mercado Pago — credenciales de PRODUCCIÓN (plata real).
# Obtenelas en https://www.mercadopago.com.ar/developers/panel/applications/<tu-app>
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_CLIENT_ID=xxxxxxxxxxxxxxxxx
MP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública de la app. MP RECHAZA localhost como back_url y notification_url.
MP_BASE_URL=https://tu-dominio.com

# Verificación de firma del webhook. En PRODUCCIÓN forzamos true.
MP_WEBHOOK_VERIFY=true

# Secreto del manifest de MP. Lo sacás del panel:
# Tu app → Notificaciones → Webhooks → Manifest
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
