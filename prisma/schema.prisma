// La Tribuna — estadio virtual de 100.000 ubicaciones.
// Cada compra (Purchase) es un visitante que sumó N hinchas para un club.
//
// Estado del pago:
//   - "pendiente": el visitante generó la preferencia en MP pero todavía no
//     recibimos el webhook que confirma el pago. Los hinchas NO pintan todavía.
//   - "pagada": MP nos confirmó el pago (webhook con status "approved"),
//     o era compra de "amigo" (arranca pagada). Los hinchas sí pintan.
//   - "rechazada": MP nos dijo que el pago fue rechazado, o el admin la descartó.
//
// `operacion` guarda el número de operación que MP le muestra al comprador
// (para el flujo manual legacy). `mpPaymentId` y `mpPreferenceId` son los IDs
// internos de MP que vienen del webhook y de la creación de la preferencia.
// `amigo` marca las compras que no requieren pago (botón "soy amigo").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Club {
  id            String   @id @default(cuid())
  slug          String   @unique // estable: "boca", "river", ...
  nombre        String
  apodo         String
  liga          String
  ciudad        String
  provincia     String
  colorPrimario String
  colorSecundario String
  createdAt     DateTime @default(now())
  purchases     Purchase[]
}

model Purchase {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id])
  cantidad        Int
  nombre          String?
  mensaje         String?
  estado          String    @default("pendiente") // "pendiente" | "pagada" | "rechazada"
  // Flujo manual legacy
  operacion       String?
  // Flujo automático Mercado Pago
  mpPreferenceId  String?
  mpPaymentId     String?
  mpStatus        String?   // "approved" | "rejected" | "pending" | "in_process" | "cancelled"
  amigo           Boolean   @default(false)
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
}
